{
  "name": "namonexus-smart-classroom",
  "version": "6.2.0",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm backend/server.ts",
    "test": "jest --experimental-vm-modules",
    "test:integration": "jest --experimental-vm-modules tests/integration/"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.140",
    "@google-cloud/logging-bunyan": "^4.1.0",
    "@openai/codex-sdk": "^0.130.0",
    "@tailwindcss/postcss": "^4.2.4",
    "bunyan": "^1.8.15",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/bunyan": "^1.8.11",
    "@types/node": "^20.19.41",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "testTimeout": 60000
  }
}
