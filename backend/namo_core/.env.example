# ============================================================
# Namo Core — Runtime Configuration Example
# ============================================================

# ============================================================
# Namo Core — Runtime Configuration Example
# ============================================================

NAMO_ENV=development
NAMO_API_HOST=127.0.0.1
NAMO_API_PORT=8000
NAMO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- GCP Configuration ---
GOOGLE_CLOUD_PROJECT=namo-classroom
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\your\namo-sa-key.json

# --- Database ---
# Production (Cloud SQL via Unix socket - for Cloud Run):
# NAMO_DATABASE_URL="postgresql+psycopg2://namo_app:<password>@/namo_classroom?host=/cloudsql/<PROJECT_ID>:<REGION>:<INSTANCE_NAME>"
# Local Testing (Cloud SQL via TCP - requires Cloud SQL Auth Proxy):
# NAMO_DATABASE_URL="postgresql+psycopg2://namo_app:<password>@127.0.0.1:5432/namo_classroom"
# Development (SQLite):
NAMO_DATABASE_URL="sqlite:///./namo_classroom.db"

# --- Security ---
# NAMO_JWT_SECRET_KEY: Generate a strong, random 32+ character string.
NAMO_JWT_SECRET_KEY="MUST_BE_SET_IN_ENV"
# NAMO_ADMIN_PASSWORD: Store a bcrypt hash here in production.
# Generate hash: python -c "import bcrypt, getpass; pw = getpass.getpass('New admin password: '); h = bcrypt.hashpw(pw.encode(), bcrypt.gensalt(rounds=12)); print('Hash:', h.decode())"
NAMO_ADMIN_PASSWORD="MUST_BE_SET_IN_ENV"
NAMO_ADMIN_USERNAME="admin"
NAMO_ENV=development # Set to "production" for production deployment

# --- LLM Reasoning ---
NAMO_REASONING_PROVIDER=mock
NAMO_REASONING_MODEL=namo-recovered-demo
NAMO_REASONING_TIMEOUT_SECONDS=30
NAMO_REASONING_ALLOW_MOCK_FALLBACK=true

# --- Speech (STT) ---
NAMO_SPEECH_PROVIDER=mock
NAMO_SPEECH_MODEL=tiny
NAMO_SPEECH_LANGUAGE=th
NAMO_SPEECH_CHUNK_MS=30
NAMO_SPEECH_SILENCE_MS=600
NAMO_SPEECH_LISTEN_TIMEOUT_SECONDS=0.35
NAMO_SPEECH_MAX_UTTERANCE_SECONDS=8.0
NAMO_SPEECH_VAD_THRESHOLD=0.015
